{% extends "layout.njk" %}
{% set activePage = "about" %}

{% block content %}
<!-- Page Header -->
<header class="page-header text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">About Us</h1>
        <p class="lead text-muted">Learn more about our mission and vision.</p>
    </div>
</header>

<!-- About Section -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="image-container">
                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-1.2.1&auto=format&fit=crop&w=1351&q=80"
                        class="img-fluid rounded shadow glass-image" alt="About Us">
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">Who We Are</h2>
                <p class="text-muted mb-4">
                    We are a passionate team of developers, designers, and innovators dedicated to creating
                    digital experiences that matter.
                    Our journey began with a simple idea: to make the web a better place for everyone.
                </p>
                <p class="text-muted mb-4">
                    With years of experience in the industry, we specialize in building responsive, accessible,
                    and performant websites.
                    We believe in the power of technology to transform businesses and lives.
                </p>
                <a href="contact.html" class="btn btn-glass">Get in Touch</a>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Services</h2>
            <p class="text-muted">What we can do for you</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="glass-card h-100 text-center">
                    <h5 class="card-title">Web Design</h5>
                    <p class="card-text small text-muted">Creating beautiful and intuitive interfaces.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="glass-card h-100 text-center">
                    <h5 class="card-title">Development</h5>
                    <p class="card-text small text-muted">Building robust and scalable applications.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="glass-card h-100 text-center">
                    <h5 class="card-title">SEO Optimization</h5>
                    <p class="card-text small text-muted">Improving your visibility on search engines.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="glass-card h-100 text-center">
                    <h5 class="card-title">Consulting</h5>
                    <p class="card-text small text-muted">Expert advice to guide your digital strategy.</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
