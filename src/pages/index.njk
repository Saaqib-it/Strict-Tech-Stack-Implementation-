{% extends "layout.njk" %}
{% set activePage = "home" %}

{% block content %}
<!-- Hero Section -->
<header class="hero-section text-center">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">Welcome to the Future</h1>
        <p class="lead mb-4">Building the next generation of web experiences with modern technologies.</p>
        <a href="about.html" class="btn btn-glass btn-lg px-5">Learn More</a>
    </div>
</header>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold section-title">Our Key Features</h2>
            <p class="text-muted section-subtitle">What makes us stand out from the crowd</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="glass-card feature-card h-100 text-center p-4">
                    <div class="mb-3 text-primary icon-glow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-speedometer2" viewBox="0 0 16 16">
                            <path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4zM3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10zm9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5zm.754-4.246a.389.389 0 0 0-.527-.02L9.647 7.6a.5.5 0 0 1-.708-.708l2.07-2.07a.389.389 0 0 0 .02-.527c.099-.23.081-.69.081-.69a1.125 1.125 0 0 0-1.25-1.25c-.23 0-.69-.081-.69-.081a.389.389 0 0 0-.527.02L6.353 4.4a.5.5 0 0 1-.708-.708l2.07-2.07a.389.389 0 0 0 .02-.527c.099-.23.081-.69.081-.69a1.125 1.125 0 0 0-1.25-1.25c-.23 0-.69-.081-.69-.081a.389.389 0 0 0-.527.02L2.732 2.732a.5.5 0 0 0-.707.707l.915.914a.5.5 0 1 0 .708-.708l-.914-.915a.5.5 0 0 0 0-.707zM8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z"/>
                        </svg>
                    </div>
                    <h5 class="card-title">Fast Performance</h5>
                    <p class="card-text">Optimized for speed and efficiency to provide the best user experience.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card feature-card h-100 text-center p-4">
                    <div class="mb-3 text-primary icon-glow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.935.536.43.174.93.174 1.363 0 .284-.116.589-.292.935-.536a10.725 10.725 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.118.265 7.31 0 8 0s1.882.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                            <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                        </svg>
                    </div>
                    <h5 class="card-title">Secure & Reliable</h5>
                    <p class="card-text">Built with security in mind to keep your data safe and accessible.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card feature-card h-100 text-center p-4">
                    <div class="mb-3 text-primary icon-glow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-laptop" viewBox="0 0 16 16">
                            <path d="M13.5 3a.5.5 0 0 1 .5.5V11H2V3.5a.5.5 0 0 1 .5-.5h11zm-11-1A1.5 1.5 0 0 0 1 3.5V12h14V3.5A1.5 1.5 0 0 0 13.5 2h-11zM0 12.5h16a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12.5z"/>
                        </svg>
                    </div>
                    <h5 class="card-title">Responsive Design</h5>
                    <p class="card-text">Looks great on any device, from mobile phones to large desktop screens.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Carousel Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-carousel carousel-container shadow rounded overflow-hidden">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" class="d-block w-100" alt="Team working">
                            <div class="carousel-caption d-none d-md-block glass-caption rounded">
                                <h5>Collaborative Environment</h5>
                                <p>We work together to achieve greatness.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" class="d-block w-100" alt="Presentation">
                            <div class="carousel-caption d-none d-md-block glass-caption rounded">
                                <h5>Innovative Solutions</h5>
                                <p>Presenting ideas that change the world.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1553877606-3c60dad1506d?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" class="d-block w-100" alt="Modern Office">
                            <div class="carousel-caption d-none d-md-block glass-caption rounded">
                                <h5>Modern Workspace</h5>
                                <p>Designed for creativity and productivity.</p>
                            </div>
                        </div>
                    </div>
                    
                    <button class="carousel-control prev" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="carousel-control next" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    
                    <div class="carousel-indicators">
                        <button class="indicator active" data-slide="0"></button>
                        <button class="indicator" data-slide="1"></button>
                        <button class="indicator" data-slide="2"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
